# Copy to BackEnd/.env and fill in real values. Never commit .env.
# All values below are placeholders.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Secret used to sign/verify JWTs. Required: the app will not start without it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-generate-a-long-random-value

# Key for the /admin endpoints, sent in the X-Admin-Key request header.
# Required: the app will not start without it.
ADMIN_API_KEY=change-me-generate-a-long-random-value

# Extra frontend origin to allow through CORS (optional locally)
FRONTEND_URL=http://localhost:5173

# DATABASE_URL is intentionally not set here. When it is unset, the backend
# uses a local SQLite file (BackEnd/syllabud.db). Do not point local dev or
# seed_dev.py at a production database.
